<Window x:Class="FinanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="FinanceTracker" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16 12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16 0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3E60"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#2D3436" RenderTransformOrigin="0.533,0.363">
            <StackPanel>
                <StackPanel Margin="16 24">
                    <TextBlock Text="FinanceTracker" Foreground="White" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Track your money" Foreground="#B2BEC3" FontSize="14" Margin="0 4 0 0" Height="20" Width="205"/>
                </StackPanel>

                <StackPanel Margin="0 25 0 0" Height="186" RenderTransformOrigin="0.55,-0.134">
                    <Button Content="🏠 Dashboard" Style="{StaticResource SidebarButton}" Click="ShowBudgetView" Height="60" RenderTransformOrigin="0.561,-0.431"/>
                    <Button Content="📊 Statistics" Style="{StaticResource SidebarButton}" Click="ShowStatsView" Height="60"/>
                    <Button Content="🔒 Limits" Style="{StaticResource SidebarButton}" Click="ShowLimitsView" Height="60"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Background="#F5F6FA">
            <Grid>
                <!-- Budget View -->
                <Grid x:Name="BudgetGrid" Margin="24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0 0 0 16">
                        <TextBlock Text="Transactions" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Add and manage your transactions" Foreground="#636E72"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0 0 0 16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0 0 12 0">
                                <TextBlock Text="Description" Margin="0 0 0 4"/>
                                <TextBox x:Name="DescriptionTextBox" Height="25"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0 0 12 0">
                                <TextBlock Text="Amount" Margin="0 0 0 4"/>
                                <TextBox x:Name="AmountTextBox" Height="25"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0 0 12 0">
                                <TextBlock Text="Type" Margin="0 0 0 4"/>
                                <ComboBox x:Name="TypeComboBox" SelectedIndex="0" Height="25">
                                    <ComboBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💰" Margin="0 0 8 0"/>
                                            <TextBlock Text="Income"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💸" Margin="0 0 8 0"/>
                                            <TextBlock Text="Expense"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="3" Content="Add" VerticalAlignment="Top" Click="AddTransaction_Click" Width="120" RenderTransformOrigin="0.506,1.235" Height="39" Margin="0,15,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="0" Margin="0 0 0 16">
                        <DataGrid x:Name="TransactionsDataGrid" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="*"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="Medium"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Income">
                                                    <Setter Property="Foreground" Value="#00B894"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                    <Setter Property="Foreground" Value="#D63031"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                <DataGridTemplateColumn Header="Action" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑" Background="Transparent" Foreground="#D63031" 
                                                    BorderThickness="0" FontSize="16" Cursor="Hand"
                                                    Click="DeleteTransaction_Click" ToolTip="Delete transaction"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0 0 16 0">
                                    <TextBlock Text="Description filter" FontWeight="Medium" Margin="0 0 0 4"/>
                                    <TextBox x:Name="FilterDescriptionTextBox" Width="200" Height="24"/>
                                </StackPanel>

                                <StackPanel Margin="0 0 16 0">
                                    <TextBlock Text="Date filter" FontWeight="Medium" Margin="0 0 0 4"/>
                                    <DatePicker x:Name="FilterDatePicker" Width="125"/>
                                </StackPanel>

                                <Button Content="Filter" Click="FilterTransactions_Click" Width="100" Margin="0 0 8 0"/>
                                <Button Content="Clear" Click="ClearFilters_Click" Width="100" Background="#DFE6E9" Foreground="#2D3436"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" x:Name="BalanceTextBlock" FontSize="18" FontWeight="Bold" 
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Statistics View -->
                <Grid x:Name="StatsGrid" Margin="24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Statistics" FontSize="20" FontWeight="Bold" Margin="0 0 0 16"/>

                        <Border Background="White" CornerRadius="8" Padding="24" Margin="0 0 0 16">
                            <StackPanel>
                                <TextBlock x:Name="TotalIncomeText" FontSize="16" Foreground="#00B894" Margin="0 0 0 8"/>
                                <TextBlock x:Name="TotalExpenseText" FontSize="16" Foreground="#D63031" Margin="0 0 0 8"/>
                                <TextBlock x:Name="TotalTransactionsText" FontSize="16" Margin="0 0 0 8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Limits View -->
                <Grid x:Name="LimitsGrid" Margin="24" Visibility="Visible"> 
                    <StackPanel>
                        <TextBlock Text="Spending Limits" FontSize="20" FontWeight="Bold" Margin="0 0 0 16"/>

                        <Border Background="White" CornerRadius="8" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Set monthly spending limit" Margin="0 0 0 8"/>

                                <StackPanel Orientation="Horizontal" Margin="0 16 0 0" Height="50">
                                    <StackPanel Margin="0 0 16 0">
                                        <TextBlock Text="Amount" Margin="0 0 0 4"/>
                                        <TextBox x:Name="LimitAmountTextBox" Width="200" Height="24"/>
                                    </StackPanel>

                                    <StackPanel Margin="0 0 16 0">
                                        <TextBlock Text="Month" Margin="0 0 0 4"/>
                                        <DatePicker x:Name="LimitDatePicker" Width="200"/>
                                    </StackPanel>

                                    <Button Content="Set Limit" Click="SetLimit_Click" VerticalAlignment="Bottom" Width="120" RenderTransformOrigin="0.497,0.691"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>