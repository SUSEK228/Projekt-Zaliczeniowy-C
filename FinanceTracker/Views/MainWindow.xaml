<Window x:Class="FinanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charting="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit"
        xmlns:visualization="clr-namespace:System.Windows.Controls.DataVisualization;assembly=System.Windows.Controls.DataVisualization.Toolkit"
        Title="FinanceTracker" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- 1. Default TextBlock style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- 2. Sidebar button style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="16,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3E60"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 3. Chart colors for legend -->
        <SolidColorBrush x:Key="PieColorIncome" Color="#355C7D"/>
        <SolidColorBrush x:Key="PieColorExpense" Color="#C06C84"/>

        <!-- 4. Common datapoint style -->
        <Style x:Key="ModernPieDataPointStyle" TargetType="{x:Type charting:PieDataPoint}">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <!-- Template bez wewnętrznego TextBlocka -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type charting:PieDataPoint}">
                        <Path Data="{TemplateBinding Geometry}"
                              Fill="{TemplateBinding Background}"
                              Stroke="{TemplateBinding BorderBrush}"
                              StrokeThickness="{TemplateBinding BorderThickness}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 5. Custom palette -->
        <visualization:ResourceDictionaryCollection x:Key="ModernPiePalette">
            <!-- 1st slice – Income -->
            <ResourceDictionary>
                <Style x:Key="DataPointStyle"
                       TargetType="{x:Type charting:PieDataPoint}"
                       BasedOn="{StaticResource ModernPieDataPointStyle}">
                    <Setter Property="Background" Value="#355C7D"/>
                </Style>
            </ResourceDictionary>
            <!-- 2nd slice – Expense -->
            <ResourceDictionary>
                <Style x:Key="DataPointStyle"
                       TargetType="{x:Type charting:PieDataPoint}"
                       BasedOn="{StaticResource ModernPieDataPointStyle}">
                    <Setter Property="Background" Value="#C06C84"/>
                </Style>
            </ResourceDictionary>
        </visualization:ResourceDictionaryCollection>

        <!-- 6. Chart container styles -->
        <Style x:Key="ModernChartStyle" TargetType="{x:Type charting:Chart}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="TransparentPlotAreaStyle" TargetType="Grid">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#2D3436">
            <StackPanel>
                <!-- Logo/Header -->
                <StackPanel Margin="16,24">
                    <TextBlock Text="FinanceTracker"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"/>
                    <TextBlock Text="Track your money"
                               Foreground="#B2BEC3"
                               FontSize="14"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation buttons -->
                <StackPanel Margin="0,25,0,0" Height="186">
                    <Button Content="🏠 Dashboard"
                            Style="{StaticResource SidebarButton}"
                            Click="ShowBudgetView"
                            Height="60"/>
                    <Button Content="📊 Statistics"
                            Style="{StaticResource SidebarButton}"
                            Click="ShowStatsView"
                            Height="60"/>
                    <Button Content="🔒 Limits"
                            Style="{StaticResource SidebarButton}"
                            Click="ShowLimitsView"
                            Height="60"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Border Grid.Column="1" Background="#F5F6FA">
            <Grid>
                <!-- Budget View -->
                <Grid x:Name="BudgetGrid" Margin="24" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Transactions" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Add and manage your transactions" Foreground="#636E72"/>
                    </StackPanel>

                    <!-- Add transaction form -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Description -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Description" Margin="0,0,0,4"/>
                                <TextBox x:Name="DescriptionTextBox" Height="25"/>
                            </StackPanel>

                            <!-- Amount -->
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Amount" Margin="0,0,0,4"/>
                                <TextBox x:Name="AmountTextBox" Height="25"/>
                            </StackPanel>

                            <!-- Type -->
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Type" Margin="0,0,0,4"/>
                                <ComboBox x:Name="TypeComboBox" SelectedIndex="0" Height="25">
                                    <ComboBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💰" Margin="0,0,8,0"/>
                                            <TextBlock Text="Income"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💸" Margin="0,0,8,0"/>
                                            <TextBlock Text="Expense"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <!-- Add button -->
                            <Button Grid.Column="3"
                                    Content="Add"
                                    VerticalAlignment="Top"
                                    Width="120"
                                    Height="39"
                                    Margin="0,15,0,0"
                                    Click="AddTransaction_Click"/>
                        </Grid>
                    </Border>

                    <!-- Transactions grid -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="0" Margin="0,0,0,16">
                        <DataGrid x:Name="TransactionsDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="*"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="Medium"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Income">
                                                    <Setter Property="Foreground" Value="#00B894"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                    <Setter Property="Foreground" Value="#D63031"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                <DataGridTemplateColumn Header="Action" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑"
                                                    Background="Transparent"
                                                    Foreground="#D63031"
                                                    BorderThickness="0"
                                                    FontSize="16"
                                                    Cursor="Hand"
                                                    ToolTip="Delete transaction"
                                                    Click="DeleteTransaction_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Filters & balance -->
                    <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Filters -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Description filter" FontWeight="Medium" Margin="0,0,0,4"/>
                                    <TextBox x:Name="FilterDescriptionTextBox" Width="200" Height="24"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Date filter" FontWeight="Medium" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="FilterDatePicker" Width="125"/>
                                </StackPanel>
                                <Button Content="Filter" Width="100" Click="FilterTransactions_Click"/>
                                <Button Content="Clear" Width="100" Background="#DFE6E9" Foreground="#2D3436" Click="ClearFilters_Click"/>
                            </StackPanel>

                            <!-- Balance -->
                            <TextBlock Grid.Column="1"
                                       x:Name="BalanceTextBlock"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Statistics View -->
                <Grid x:Name="StatsGrid" Margin="24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Statistics" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                        <!-- Summary card -->
                        <Border Background="White" CornerRadius="8" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TotalIncomeText" FontSize="16" Foreground="#00B894" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TotalExpenseText" FontSize="16" Foreground="#D63031" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TotalTransactionsText" FontSize="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Chart card -->
                        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect Color="#000" Opacity="0.12" BlurRadius="8" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Income vs Expenses" FontSize="16" FontWeight="Bold" Foreground="#2D3436" Margin="0,0,0,10"/>

                                <!-- Legend -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Ellipse Width="12" Height="12" Fill="{StaticResource PieColorIncome}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Income" FontSize="14" Foreground="#444"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="{StaticResource PieColorExpense}" Margin="0,0,4,0"/>
                                        <TextBlock Text="Expenses" FontSize="14" Foreground="#444"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Chart -->
                                <charting:Chart x:Name="StatsChart"
                                                Style="{StaticResource ModernChartStyle}"
                                                Height="300"
                                                PlotAreaStyle="{StaticResource TransparentPlotAreaStyle}"
                                                Palette="{StaticResource ModernPiePalette}">
                                    <charting:Chart.Series>
                                        <charting:PieSeries x:Name="PieSeries"
                                                            IndependentValuePath="Key"
                                                            DependentValuePath="Value"
                                                            IsSelectionEnabled="True"/>
                                    </charting:Chart.Series>
                                </charting:Chart>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Limits View -->
                <Grid x:Name="LimitsGrid" Margin="24" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Spending Limits" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                        <Border Background="White" CornerRadius="8" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Set monthly spending limit" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Height="50">
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Amount" Margin="0,0,0,4"/>
                                        <TextBox x:Name="LimitAmountTextBox" Width="200" Height="24"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Month" Margin="0,0,0,4"/>
                                        <DatePicker x:Name="LimitDatePicker" Width="200"/>
                                    </StackPanel>
                                    <Button Content="Set Limit" Width="120" VerticalAlignment="Bottom" Click="SetLimit_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
