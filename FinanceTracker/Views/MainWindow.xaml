<Window x:Class="FinanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FinanceTracker" Height="600" Width="900"
        Background="#BABAC4" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#8387C3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3E60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel boczny -->
        <StackPanel Background="#0A1123" Grid.Column="0">
            
            <TextBlock Text="FinanceTracker" Foreground="#8387C3" FontSize="22" FontWeight="Bold" Margin="10"/>
            
            <Separator Margin="10,5" Background="#959B95"/>
            
            <Button Content="🏠 Budżet" 
                    Click="ShowBudgetView" 
                    Background="Transparent" 
                    Foreground="White" 
                    BorderBrush="Transparent" 
                    FontSize="16"
                    HorizontalAlignment="Left"
                    Margin="20,5,10,5"/>
            <Button Content="📊 Statystyki" 
                    Click="ShowStatsView" 
                    Background="Transparent" 
                    Foreground="White" 
                    BorderBrush="Transparent" 
                    FontSize="16" 
                    HorizontalAlignment="Left"
                    Margin="20,5,10,5"/>
        </StackPanel>

        <!-- Widok Budżetu -->
        <Grid x:Name="BudgetGrid" Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Dodaj nową transakcję" FontSize="18" FontWeight="Bold" Foreground="#3A3E60"/>

            <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                <TextBox x:Name="DescriptionTextBox" Width="200" Height="30" Margin="5" ToolTip="Opis transakcji"/>
                <TextBox x:Name="AmountTextBox" Width="100" Height="30" Margin="5" ToolTip="Kwota"/>
                <ComboBox x:Name="TypeComboBox" Width="150" Height="30" Margin="5" SelectedIndex="0">
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" Margin="0,0,5,0"/>
                            <TextBlock Text="Przychód"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💸" Margin="0,0,5,0"/>
                            <TextBlock Text="Wydatek"/>
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>
                <Button Content="Dodaj" Width="100" Height="30" Click="AddTransaction_Click"/>
            </WrapPanel>

            <DataGrid x:Name="TransactionsDataGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Margin="0,0,0,10">

                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="Income">
                                <Setter Property="Background" Value="#D9FFE5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Expense">
                                <Setter Property="Background" Value="#FFE5E5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=d}" Width="*"/>
                    <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="2*"/>
                    <DataGridTemplateColumn Header="Kwota" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Amount}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Income">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="*"/>
                    <DataGridTemplateColumn Header="Usuń" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑" Background="Transparent" BorderBrush="Transparent"
                                        FontSize="16" Foreground="DarkRed" Cursor="Hand"
                                        Click="DeleteTransaction_Click" ToolTip="Usuń transakcję"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="BalanceTextBlock"
                       Grid.Row="3"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       Foreground="#0A1123"/>
        </Grid>

        <!-- Widok Statystyk -->
        <Grid x:Name="StatsGrid" Grid.Column="1" Margin="20" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="📊 Podsumowanie" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Margin="0,0,0,10"/>
                <TextBlock x:Name="TotalIncomeText" 
                           FontSize="16" 
                           Foreground="Green" 
                           Margin="0,5"/>
                <TextBlock x:Name="TotalExpenseText" 
                           FontSize="16" 
                           Foreground="Red" 
                           Margin="0,5"/>
                <TextBlock x:Name="TotalTransactionsText" 
                           FontSize="16" 
                           Margin="0,5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
